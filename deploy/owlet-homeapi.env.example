# Configuration for the owlet-homeapi systemd service.
#
# Installed to /etc/owlet-homeapi/owlet-homeapi.env (mode 0640, readable by
# the service user only). Run "sudo systemctl restart owlet-homeapi" after
# editing this file.

# --- Owlet cloud credentials (required) ---------------------------------
# The email address and password of your Owlet account.
OWLET_EMAIL=""
OWLET_PASSWORD=""

# --- Collection ---------------------------------------------------------
# How often a reading is fetched and published, in seconds.
OWLET_POLL_INTERVAL="2"

# How often the Owlet cloud data stream is re-armed, in seconds. The sock
# only streams live data while an app (or this service) marks itself
# active, so this has to happen regularly, but far less often than polling.
OWLET_REACTIVATE_INTERVAL="10"

# Only publish this device serial number (DSN). Empty means all devices.
OWLET_DEVICE=""

# Comma separated list of Owlet attributes to publish. Empty means every
# attribute the device exposes, for example:
# OWLET_ATTRIBUTES="HEART_RATE,OXYGEN_LEVEL,MOVEMENT,BATT_LEVEL"
OWLET_ATTRIBUTES=""

# --- HomeAPI target -----------------------------------------------------
# Base URL of the HomeAPI server on your LAN.
HOMEAPI_URL="http://localhost:9999"

# Category and key prefix used for the created entries. The entry key is
# "<prefix>_<dsn>", plus "_<epoch>" when publishing in history mode.
HOMEAPI_CATEGORY="owlet"
HOMEAPI_KEY_PREFIX="owlet"

# HTTP timeout for HomeAPI requests, in seconds.
HOMEAPI_TIMEOUT="10"

# "latest" keeps a single, continuously updated entry per device.
# "history" creates one entry per reading - be aware that at a two second
# interval this is roughly 43000 entries per device per day.
OWLET_PUBLISH_MODE="latest"

# --- Logging ------------------------------------------------------------
# debug, info, warning or error. Logs go to the journal:
# journalctl -u owlet-homeapi -f
OWLET_LOG_LEVEL="info"
