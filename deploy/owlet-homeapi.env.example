# Configuration for the owlet-homeapi systemd services, shared by the
# collector (owlet-homeapi.service) and the daily roll up
# (owlet-summarize.timer).
#
# Installed to /etc/owlet-homeapi/owlet-homeapi.env (mode 0640, readable by
# the service user only). Run "sudo systemctl restart owlet-homeapi" after
# editing this file.

# --- Owlet cloud credentials (required) ---------------------------------
# The email address and password of your Owlet account.
OWLET_EMAIL=""
OWLET_PASSWORD=""

# --- Collection ---------------------------------------------------------
# How often a reading is fetched and published, in seconds.
OWLET_POLL_INTERVAL="2"

# How often the Owlet cloud data stream is re-armed, in seconds. The sock
# only streams live data while an app (or this service) marks itself
# active, so this has to happen regularly, but far less often than polling.
OWLET_REACTIVATE_INTERVAL="10"

# Only publish this device serial number (DSN). Empty means all devices.
OWLET_DEVICE=""

# Comma separated list of Owlet attributes to publish. Empty means every
# attribute the device exposes, for example:
# OWLET_ATTRIBUTES="HEART_RATE,OXYGEN_LEVEL,MOVEMENT,BATT_LEVEL"
OWLET_ATTRIBUTES=""

# --- HomeAPI target -----------------------------------------------------
# Base URL of the HomeAPI server on your LAN.
HOMEAPI_URL="http://localhost:9999"

# Category and key prefix used for the created entries. The entry key is
# "<prefix>_<dsn>", plus "_<epoch>" when publishing in history mode.
HOMEAPI_CATEGORY="owlet"
HOMEAPI_KEY_PREFIX="owlet"

# HTTP timeout for HomeAPI requests, in seconds.
HOMEAPI_TIMEOUT="10"

# "history" creates one entry per reading, which is what the daily roll
# up summarizes and then deletes. "latest" keeps a single, continuously
# updated entry per device instead, which leaves nothing to summarize.
# "both" does the two of them: a current entry plus the raw series.
OWLET_PUBLISH_MODE="history"

# --- Logging ------------------------------------------------------------
# debug, info, warning or error. Logs go to the journal:
# journalctl -u owlet-homeapi -f
OWLET_LOG_LEVEL="info"

# --- Daily roll up ------------------------------------------------------
# owlet-summarize.timer runs once a day, writes one summary entry per
# device and day plus one per ISO week, and then deletes the per-reading
# entries it has summarized.

# Category and key prefix of the summary entries. They must differ from
# HOMEAPI_CATEGORY / HOMEAPI_KEY_PREFIX above so that summaries are never
# mistaken for raw readings.
HOMEAPI_SUMMARY_CATEGORY="owlet_summary"
HOMEAPI_SUMMARY_KEY_PREFIX="owlet_summary"

# Metrics to summarize. Empty means heart_rate, oxygen_level, movement
# and battery_level.
OWLET_SUMMARY_METRICS=""

# Extra days of per-reading entries to keep after they were summarized.
# 0 deletes yesterday's readings as soon as its summary is written, 7
# keeps a week of raw data around.
OWLET_RAW_RETENTION_DAYS="0"
